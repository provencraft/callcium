{
  "name": "@callcium/sdk",
  "version": "0.12.0",
  "description": "TypeScript implementation of the Callcium policy engine",
  "keywords": [
    "abi",
    "callcium",
    "ethereum",
    "evm",
    "policy",
    "smart-contracts",
    "typescript",
    "web3"
  ],
  "homepage": "https://callcium.dev",
  "bugs": "https://github.com/provencraft/callcium/issues",
  "license": "MIT",
  "author": "Seva Mihailov",
  "repository": {
    "type": "git",
    "url": "https://github.com/provencraft/callcium.git",
    "directory": "packages/sdk"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "typedoc": "typedoc",
    "replay": "bun tools/replay.ts",
    "differential": "bun tools/differential.ts"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@vitest/coverage-v8": "5.0.5",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "tsdown": "0.23.1",
    "typedoc": "0.28.20",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.11.0"
  }
}
