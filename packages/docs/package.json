{
  "name": "@callcium/docs",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "bunx serve out",
    "typecheck": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "lint": "oxlint && bun tools/lint-links.ts",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "sync": "bun run sync:reference && bun run sync:sdk-reference && bun run sync:specs",
    "sync:reference": "bun run --cwd ../contracts docs && bun tools/sync-reference.ts",
    "sync:sdk-reference": "bun run --cwd ../sdk typedoc && bun tools/sync-sdk-reference.ts",
    "sync:specs": "bun tools/sync-specs.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@callcium/sdk": "workspace:*",
    "@icons-pack/react-simple-icons": "13.15.1",
    "@radix-ui/react-select": "2.4.1",
    "clsx": "2.1.1",
    "fumadocs-core": "16.17.7",
    "fumadocs-mdx": "15.4.9",
    "fumadocs-typescript": "5.5.2",
    "fumadocs-ui": "16.17.7",
    "lucide-react": "1.60.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "viem": "2.57.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "mdast-util-to-string": "4.0.0",
    "next-validate-link": "1.6.7",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "postcss": "8.5.31",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "unified": "11.0.5",
    "unist-util-remove": "4.0.0",
    "unist-util-visit": "5.1.0",
    "vitest": "5.0.5"
  }
}
